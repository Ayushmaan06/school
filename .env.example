# Required
DATABASE_URL=postgresql+psycopg://school_intel:school_intel@localhost:5433/school_intel

# Optional (defaults shown)
RAW_STORE_PATH=./raw
USER_AGENT=TensorSchoolIntel/0.1 (+internal BD research; contact: bd@tensor.school)
LOG_LEVEL=INFO

# v1 scope. Widening this is a config change, not a code change. M1-1.
TARGET_STATES=["KA","TN","MH"]

# ADR-013. Leave false. The pipeline must run with no key set; there is a test.
EXTRACTION_LLM_ENABLED=false
# ANTHROPIC_API_KEY=
# SERPER_API_KEY=
